{
  "name": "luckydraw",
  "private": true,
  "version": "1.0.0",
  "description": "Luckydraw - B/S 抽奖系统（转盘动画 + 事务安全发奖）",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "server": "npm run dev --workspace=server",
    "web": "npm run dev --workspace=web",
    "seed": "npm run seed --workspace=server",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
